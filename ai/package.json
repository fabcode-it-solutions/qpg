{
  "name": "q-ai-server",
  "version": "1.0.0",
  "description": "Q AI Assistant - Plant Cultivation Support System",
  "main": "dist/index.js",
  "scripts": {
    "start": "node --max-old-space-size=512 --expose-gc dist/index.js",
    "start:prod": "NODE_ENV=production node --max-old-space-size=512 --expose-gc dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "node build.js",
    "build:prod": "NODE_ENV=production node build.js",
    "build:tsc": "node --max-old-space-size=1024 node_modules/typescript/bin/tsc",
    "build:simple": "tsc src/index.ts --outDir dist --target ES2020 --module commonjs --esModuleInterop --skipLibCheck --resolveJsonModule",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "health-check": "curl -f http://localhost:3010/health || exit 1",
    "clean": "rm -rf dist logs/*.log",
    "prestart": "npm run clean && npm run build:prod"
  },
  "keywords": [
    "ai",
    "assistant",
    "cultivation",
    "langchain",
    "gemini"
  ],
  "author": "QPG Team",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.848.0",
    "@langchain/core": "^0.3.62",
    "node-fetch": "^3.3.2",
    "@langchain/google-genai": "^0.1.2",
    "@langchain/langgraph": "^0.3.8",
    "@langchain/langgraph-supervisor": "^0.0.15",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "langchain": "^0.3.29",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "pgvector": "^0.2.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.25.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
